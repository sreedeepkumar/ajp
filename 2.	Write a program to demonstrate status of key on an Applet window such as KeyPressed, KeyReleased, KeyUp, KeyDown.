import java.applet.Applet;
import java.awt.Graphics;
import java.awt.event.KeyEvent;
import java.awt.event.KeyListener;

/*
<applet code="KeyStatusApplet.class" width="400" height="200">
</applet>
*/

public class KeyStatusApplet extends Applet implements KeyListener
{
    String msg = "";

    public void init()
    {
        addKeyListener(this);
        requestFocus();
    }

    public void keyPressed(KeyEvent e)
    {
        msg = "Key Pressed : " + e.getKeyChar();
        repaint();
    }

    public void keyReleased(KeyEvent e)
    {
        msg = "Key Released : " + e.getKeyChar();
        repaint();
    }

    public void keyTyped(KeyEvent e)
    {
        msg = "Key Typed : " + e.getKeyChar();
        repaint();
    }

    public void paint(Graphics g)
    {
        g.drawString(msg, 100, 100);
    }
}
