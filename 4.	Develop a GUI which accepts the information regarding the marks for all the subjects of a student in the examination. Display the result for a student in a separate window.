import java.awt.*;
import java.awt.event.*;

public class StudentResultGUI extends Frame implements ActionListener
{
    Label l1, l2, l3, l4, l5, l6;
    TextField t1, t2, t3, t4, t5;
    Button b;

    StudentResultGUI()
    {
        setTitle("Student Marks Entry");

        l1 = new Label("Java:");
        l2 = new Label("Python:");
        l3 = new Label("DBMS:");
        l4 = new Label("CN:");
        l5 = new Label("OS:");

        t1 = new TextField();
        t2 = new TextField();
        t3 = new TextField();
        t4 = new TextField();
        t5 = new TextField();

        b = new Button("Show Result");

        l1.setBounds(50, 60, 100, 30);
        t1.setBounds(160, 60, 100, 30);

        l2.setBounds(50, 100, 100, 30);
        t2.setBounds(160, 100, 100, 30);

        l3.setBounds(50, 140, 100, 30);
        t3.setBounds(160, 140, 100, 30);

        l4.setBounds(50, 180, 100, 30);
        t4.setBounds(160, 180, 100, 30);

        l5.setBounds(50, 220, 100, 30);
        t5.setBounds(160, 220, 100, 30);

        b.setBounds(120, 280, 120, 40);

        add(l1); add(t1);
        add(l2); add(t2);
        add(l3); add(t3);
        add(l4); add(t4);
        add(l5); add(t5);
        add(b);

        b.addActionListener(this);

        setSize(400, 400);
        setLayout(null);
        setVisible(true);
    }

    public void actionPerformed(ActionEvent e)
    {
        int m1 = Integer.parseInt(t1.getText());
        int m2 = Integer.parseInt(t2.getText());
        int m3 = Integer.parseInt(t3.getText());
        int m4 = Integer.parseInt(t4.getText());
        int m5 = Integer.parseInt(t5.getText());

        int total = m1 + m2 + m3 + m4 + m5;
        double percentage = total / 5.0;

        Frame resultFrame = new Frame("Student Result");

        Label r1 = new Label("Total Marks = " + total);
        Label r2 = new Label("Percentage = " + percentage + "%");

        r1.setBounds(80, 100, 200, 30);
        r2.setBounds(80, 150, 200, 30);

        resultFrame.add(r1);
        resultFrame.add(r2);

        resultFrame.setSize(300, 300);
        resultFrame.setLayout(null);
        resultFrame.setVisible(true);
    }

    public static void main(String args[])
    {
        new StudentResultGUI();
    }
}
